generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  USUARIO
  MENTOR
  ADMIN
}

enum TipoEvento {
  OPEAR_PRIMA
  COMUNIDAD
}

enum TipoProyecto {
  COMUNIDAD
  ENTIDAD
}

enum Gender {
  MASCULINO
  FEMENINO
  NO_BINARIO
  GENERO_FLUIDO
  TRANSGENERO
  OTRO
  NO_ESPECIFICAR
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  EXPIRADO
  REEMBOLSADO
}

model Usuario {
  id          String   @id @default(uuid())

  supabaseId  String   @unique

  username    String   @unique

  email       String   @unique

  firstName   String

  lastName    String

  countryCode String

  phone       String

  birthDate   DateTime?

  gender      Gender?

  rol         Rol

  newsletter  Boolean @default(false)

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

  perfil        Perfil?

  mentor        Mentor?

  eventos       Evento[]

  entradas      Entrada[]

  proyectos     Proyecto[]

  testimonios   Testimonial[]

  gallery       UserGallery[]
}

model Mentor {
  id            String   @id @default(uuid())

  usuarioId     String?  @unique

  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  name          String

  title         String

  location      String

  focus         String   @db.Text

  notes         String[]

  galleryImages Json?

  active        Boolean  @default(true)

  orden         Int      @default(0)

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([orden])
}

model Perfil {
  id            String   @id @default(uuid())

  usuarioId     String   @unique

  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  artisticName  String?

  realName      String?

  bio           String? @db.Text

  avatar        String?

  banner        String?

  tags          String[]

  interests     String[]

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  redes         Social[]
}

model UserGallery {
  id        String   @id @default(uuid())

  usuarioId String

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  src       String

  publicId  String?

  title     String?

  alt       String?

  span      String?

  orden     Int      @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([usuarioId])
}

model Social {
  id        String @id @default(uuid())

  perfilId  String

  perfil    Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  label     String

  handle    String

  href      String
}

model Evento {
  id               String   @id @default(uuid())

  titulo           String

  descripcion      String   @db.Text

  categoria        String

  tipo             TipoEvento @default(COMUNIDAD)

  disciplinas      String[]

  fecha            DateTime

  ubicacion        String

  imagen           String?

  urlPago           String?

  precio           Int

  cuposTotales     Int

  cuposDisponibles Int

  agotado          Boolean  @default(false)

  likes            Int      @default(0)

  comentarios      Int      @default(0)

  vistas           Int      @default(0)

  usuarioId        String

  usuario          Usuario @relation(fields: [usuarioId], references: [id])

  entradas         Entrada[]

  createdAt        DateTime @default(now())

  updatedAt        DateTime @updatedAt
}

model Entrada {
  id         String   @id @default(uuid())

  usuarioId  String

  eventoId   String

  pagoId     String?

  qrCode     String?
  
  usada      Boolean   @default(false)

  usadaEn    DateTime?

  usuario    Usuario @relation(fields: [usuarioId], references: [id])

  evento     Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  pago       Pago? @relation(fields: [pagoId], references: [id])

  createdAt  DateTime @default(now())

  updatedAt  DateTime @updatedAt
}


model Pago {
  id                      String   @id @default(uuid())

  referencia              String   @unique

  stripeSessionId         String?  @unique

  stripePaymentIntentId   String?  @unique

  monto                   Int

  estado                  EstadoPago @default(PENDIENTE)

  entradas                Entrada[]

  createdAt               DateTime @default(now())

  updatedAt               DateTime @updatedAt
}

model DeletedEventBackup {
  id        String   @id @default(uuid())
  eventoId  String
  data      Json
  deletedAt DateTime @default(now())
}

model Proyecto {
  id            String      @id @default(uuid())
  tipo          TipoProyecto @default(COMUNIDAD)
  nombre        String
  representante String
  descripcion   String      @db.Text
  queBuscan     String      @db.Text
  requisitos    String      @db.Text
  proceso       String      @db.Text
  imagen        String?
  contacto      String
  disciplinas   String[]
  ubicacion     String
  destacado     Boolean     @default(false)
  fechaLimite   DateTime
  usuarioId     String?
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model PageContent {
  id        String   @id @default(uuid())

  slug      String   @unique

  title     String

  blocks    Json

  published Boolean  @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(uuid())

  text      String   @db.Text

  active    Boolean  @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  usuarioId String

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([usuarioId])
}