generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  USUARIO
  MENTOR
}

enum TipoEvento {
  OPEAR_PRIMA
  COMUNIDAD
}

enum TipoProyecto {
  OPERA_PRIMA
  COMUNIDAD
  ENTIDAD
}

enum Gender {
  MASCULINO
  FEMENINO
  NO_BINARIO
  GENERO_FLUIDO
  TRANSGENERO
  OTRO
  NO_ESPECIFICAR
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  EXPIRADO
  REEMBOLSADO
}

model Usuario {
  id          String   @id @default(uuid())

  supabaseId  String   @unique

  username    String   @unique

  email       String   @unique

  firstName   String

  lastName    String

  countryCode String

  phone       String

  birthDate   DateTime?

  gender      Gender?

  rol         Rol

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

  perfil      Perfil?

  eventos     Evento[]

  entradas    Entrada[]

  proyectos   Proyecto[]
}

model Perfil {
  id            String   @id @default(uuid())

  usuarioId     String   @unique

  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  artisticName  String?

  realName      String?

  bio           String? @db.Text

  avatar        String?

  banner        String?

  tags          String[]

  interests     String[]

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  redes         Social[]
}

model Social {
  id        String @id @default(uuid())

  perfilId  String

  perfil    Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  label     String

  handle    String

  href      String
}

model Evento {
  id               String   @id @default(uuid())

  titulo           String

  descripcion      String   @db.Text

  categoria        String

  fecha            DateTime

  ubicacion        String

  imagen           String?

  urlPago           String?

  precio           Int

  cuposTotales     Int

  cuposDisponibles Int

  agotado          Boolean  @default(false)

  likes            Int      @default(0)

  comentarios      Int      @default(0)

  vistas           Int      @default(0)

  usuarioId        String

  usuario          Usuario @relation(fields: [usuarioId], references: [id])

  entradas         Entrada[]

  tipo             TipoEvento @default(OPEAR_PRIMA)
  disciplinas      String[]
  link             String?
  createdAt        DateTime @default(now())

  updatedAt        DateTime @updatedAt
}

model Entrada {
  id         String   @id @default(uuid())

  usuarioId  String

  eventoId   String

  qrCode     String?

  usuario    Usuario @relation(fields: [usuarioId], references: [id])

  evento     Evento @relation(fields: [eventoId], references: [id])

  pago       Pago?

  createdAt  DateTime @default(now())

  updatedAt  DateTime @updatedAt

}

model Pago {
  id                 String   @id @default(uuid())

  entradaId          String   @unique

  referencia         String   @unique

  transaccionWompiId String?  @unique

  monto              Int

  estado             EstadoPago @default(PENDIENTE)

  entrada            Entrada @relation(fields: [entradaId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())

  updatedAt          DateTime @updatedAt
}

model Proyecto {
  id            String       @id @default(uuid())
  tipo          TipoProyecto @default(COMUNIDAD)
  nombre        String
  representante String
  descripcion   String       @db.Text
  queBuscan     String       @db.Text
  requisitos    String       @db.Text
  proceso       String       @db.Text
  imagen        String?
  contacto      String
  disciplinas   String[]
  ubicacion     String
  destacado     Boolean      @default(false)
  fechaLimite   DateTime
  usuarioId     String?
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}